# 仅为本地开发示例；复制为 .env 后设置自己生成的值，不提交 .env。
SV_MYSQL_ROOT_PASSWORD=replace-with-local-secret
SV_MYSQL_PASSWORD=replace-with-local-secret
SV_S3_ACCESS_KEY=replace-with-local-access-key
SV_S3_SECRET_KEY=replace-with-local-secret-key
SV_S3_ENDPOINT=http://127.0.0.1:9000
SV_S3_BUCKET=store-vision
SV_S3_PREFIX=phase2-demo
SV_S3_REGION=us-east-1
SV_MYSQL_DSN=store_vision:replace-with-local-secret@tcp(127.0.0.1:3307)/store_vision?parseTime=true
