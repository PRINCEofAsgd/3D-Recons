# 仅为键名示例；复制到被忽略的 cloud-local/argo-runtime.env 后填本地值。
SV_S3_ENDPOINT=http://minio.example:9000
SV_S3_BUCKET=store-vision
SV_S3_PREFIX=phase4-demo
SV_S3_REGION=us-east-1
SV_S3_ACCESS_KEY=replace-with-local-access-key
SV_S3_SECRET_KEY=replace-with-local-secret-key
SV_RAY_ADDRESS=ray://ray-head.example:10001
# 已启用 token 认证的 Ray 集群还需在本地 Secret 中设置 RAY_AUTH_TOKEN。
# 仅本机隔离的合成 Ray 示例可在本地 Secret 添加 RAY_AUTH_MODE=disabled。
SV_RAY_TASK_CPUS=1
SV_RAY_TASK_GPUS=0
SV_RAY_TASK_MEMORY_BYTES=268435456
SV_RAY_MAX_IN_FLIGHT=2
SV_RAY_MAX_ATTEMPTS=2
# 仅合成实验才设为 1；普通任务应删去或设为 0。
SV_USE_SYNTHETIC_REPORT=0
